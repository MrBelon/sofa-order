# PostgreSQL (external, shared)
DATABASE_URL="postgresql://user:password@postgres:5432/drink_order"

# Password for /admin
ADMIN_PASSWORD="change-me"

# Server-side only. Never expose it with a NEXT_PUBLIC_ prefix.
HOME_ASSISTANT_WEBHOOK_URL="https://home-assistant.example.com/api/webhook/xxxxxxxx"

# Build-time value (inlined in the client bundle)
NEXT_PUBLIC_APP_NAME="Drink Order"
